{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "LitterLog",
  "options": {
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false,
    "deploymentTarget": {
      "iOS": "26.0"
    }
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "LitterLog": {
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "LitterLog",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ],
          "NSLocalNetworkUsageDescription": "LitterLog connects to your home server to show your cats\u2019 activity, camera feed, and Litter-Robot status.",
          "NSAppTransportSecurity": {
            "NSAllowsLocalNetworking": true
          }
        }
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.litterlog.app",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1"
      },
      "sources": [
        {
          "path": "App"
        }
      ],
      "type": "application"
    }
  }
}
